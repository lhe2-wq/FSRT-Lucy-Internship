# Local fsrt-remote.toml — configuration for `fsrt mint-fct`.
#
# This file is GITIGNORED because it contains auth material.

# All apps mint via the global-app GraphQL request shape.

# Site domain — the full host, e.g. "your-site.atlassian.net".
# The GraphQL gateway URL is derived from this automatically.
site_domain = "your-site.domain.net"

# --- App/site IDs ------------------------------------------------------------
# cloud_id is omitted, derived automatically from site_domain via tenant-info endpoint.
installation_id = "00000000-0000-0000-0000-000000000000"
# environment_key = "production"

# --- Auth --------------------------------------------------------------------
# Session cookie is the only supported auth method.
[auth]
raw_cookie_file = "./session-cookie.txt"
