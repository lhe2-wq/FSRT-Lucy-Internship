# Local fsrt-remote.toml — configuration for `fsrt mint-fct`.
#
# This file is GITIGNORED because it contains auth material.

# GraphQL request *shape* is auto-detected from the module's manifest namespace
# Set to to force a shape for a supported module:
# product = "global"   # or "confluence"

# Atlassian site subdomain (the "<site>" in <site>.atlassian.net). The GraphQL
# gateway URL is derived from this automatically.
site_id = "your-site"

# --- App/site IDs (apply to any product) -------------------------------------
cloud_id        = "00000000-0000-0000-0000-000000000000"
installation_id = "00000000-0000-0000-0000-000000000000"
# environment_key = "production"

# --- Auth --------------------------------------------------------------------
# Option 1: session cookie (works for all products).
[auth]
type = "raw_cookie"
raw_cookie_file = "./session-cookie.txt"

# Option 2: API token (working for Confluence only).
# Generate at: https://id.atlassian.com/manage-profile/security/api-tokens
# type = "basic_api_token"
# email = "email-here@example.com"
# api_token_file = "./api-token.txt"
